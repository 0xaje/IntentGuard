# Base Sepolia RPC endpoint. Never commit a credential-bearing URL.
BASE_SEPOLIA_RPC_URL=https://YOUR_BASE_SEPOLIA_RPC_ENDPOINT

# Deployment signer. Use a dedicated low-balance testnet key.
INTENTGUARD_DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Public admin and evaluator addresses.
INTENTGUARD_ADMIN=0xYOUR_ADMIN_ADDRESS
INTENTGUARD_EVALUATOR=0xYOUR_EVALUATOR_ADDRESS

# Evaluator signer used only by scripts/verify-testnet.ts.
INTENTGUARD_EVALUATOR_PRIVATE_KEY=0xYOUR_EVALUATOR_PRIVATE_KEY

# Optional public manifest path.
INTENTGUARD_DEPLOYMENT_OUTPUT=deployments/baseSepolia.json

# Optional verification output path; this file is gitignored.
INTENTGUARD_VERIFICATION_OUTPUT=deployments/baseSepolia-verification.json
